<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Workshop Numerasi</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8 text-gray-800">
    <div class="max-w-5xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-3xl font-bold mb-6 text-blue-800">Workshop Penguatan Numerasi</h1>

        <!-- Tombol Navigasi Tab -->
        <div class="flex border-b pb-2 mb-6">
            <button id="btn-desain" class="tab-btn px-4 py-2 bg-blue-500 text-white rounded mr-2 font-semibold">Desain Pembelajaran</button>
            <button id="btn-kantin" class="tab-btn px-4 py-2 bg-gray-200 text-gray-700 rounded mr-2 hover:bg-gray-300">Kasus Kantin</button>
            <button id="btn-kasus" class="tab-btn px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">Bank Kasus Numerasi</button>
        </div>

        <!-- Tab 1: Desain Pembelajaran -->
        <div id="konten-desain" class="tab-content block">
            <h2 class="text-xl font-bold mb-4">Peta Bukti Belajar (Learning Evidence Map)</h2>
            <p class="mb-4 text-sm">Pastikan terdapat keterkaitan yang jelas antara Tujuan Pembelajaran, Aktivitas Murid, Learning Evidence, dan Teknik Asesmen.</p>
            <div class="overflow-x-auto">
                <table class="w-full border-collapse border border-gray-300 text-sm">
                    <thead>
                        <tr class="bg-blue-100">
                            <th class="border border-gray-300 px-4 py-2">CP</th>
                            <th class="border border-gray-300 px-4 py-2">Tujuan Pembelajaran</th>
                            <th class="border border-gray-300 px-4 py-2">Aktivitas Belajar</th>
                            <th class="border border-gray-300 px-4 py-2">Bukti Belajar</th>
                            <th class="border border-gray-300 px-4 py-2">Teknik Asesmen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2" contenteditable="true">Klik untuk mengisi CP...</td>
                            <td class="border border-gray-300 px-4 py-2" contenteditable="true">...</td>
                            <td class="border border-gray-300 px-4 py-2" contenteditable="true">...</td>
                            <td class="border border-gray-300 px-4 py-2" contenteditable="true">...</td>
                            <td class="border border-gray-300 px-4 py-2" contenteditable="true">...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab 2: Studi Kasus Kantin -->
        <div id="konten-kantin" class="tab-content hidden">
            <h2 class="text-xl font-bold mb-4">Analisis Data Survei Kantin</h2>
            <p class="mb-4">Sekolah melakukan survei kepada 200 peserta didik mengenai menu makan siang yang paling mereka sukai.</p>
            <table class="w-1/2 border-collapse border border-gray-300 text-sm mb-4">
                <thead>
                    <tr class="bg-green-100">
                        <th class="border border-gray-300 px-4 py-2 text-left">Menu</th>
                        <th class="border border-gray-300 px-4 py-2 text-left">Jumlah Pemilih</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="border border-gray-300 px-4 py-1">Nasi Ayam</td><td class="border border-gray-300 px-4 py-1">72</td></tr>
                    <tr><td class="border border-gray-300 px-4 py-1">Nasi Ikan</td><td class="border border-gray-300 px-4 py-1">48</td></tr>
                    <tr><td class="border border-gray-300 px-4 py-1">Nasi Sayur</td><td class="border border-gray-300 px-4 py-1">36</td></tr>
                    <tr><td class="border border-gray-300 px-4 py-1">Bakso</td><td class="border border-gray-300 px-4 py-1">28</td></tr>
                    <tr><td class="border border-gray-300 px-4 py-1">Soto Ayam</td><td class="border border-gray-300 px-4 py-1">16</td></tr>
                    <tr class="font-bold bg-gray-50"><td class="border border-gray-300 px-4 py-1">Jumlah</td><td class="border border-gray-300 px-4 py-1">200</td></tr>
                </tbody>
            </table>
            <button class="bg-green-500 text-white px-4 py-2 rounded">Lihat Tugas Analisis</button>
        </div>

        <!-- Tab 3: Bank Kasus Numerasi -->
        <div id="konten-kasus" class="tab-content hidden">
            <h2 class="text-xl font-bold mb-4">Draf RPP: Integrasi Numerasi (Waktu Layar)</h2>
            <p class="mb-2"><strong>Mata Pelajaran:</strong> Bahasa Indonesia & Matematika (Numerasi)</p>
            <div class="bg-yellow-50 p-4 border border-yellow-200 rounded">
                <h3 class="font-bold">Stimulus Data (Rata-Rata Waktu Layar Remaja Usia 12-15 Tahun):</h3>
                <ul class="list-disc ml-5 mt-2 text-sm">
                    <li>Tahun 2023: 4 Jam/hari</li>
                    <li>Tahun 2024: 5,5 Jam/hari</li>
                    <li>Tahun 2025: 7 Jam/hari</li>
                    <li>Tahun 2026: 6,5 Jam/hari</li>
                </ul>
                <p class="mt-4 text-sm font-semibold">Tugas Siswa: Menyusun paragraf argumentasi berbasis data di atas untuk meyakinkan pembaca agar mengurangi waktu layar gawai.</p>
            </div>
        </div>
    </div>

    <script>
        // Logika sederhana untuk berpindah Tab
        const tabs = ['desain', 'kantin', 'kasus'];

        tabs.forEach(tab => {
            document.getElementById(`btn-${tab}`).addEventListener('click', function() {
                // Sembunyikan semua konten dan ubah gaya tombol menjadi tidak aktif
                tabs.forEach(t => {
                    document.getElementById(`konten-${t}`).classList.add('hidden');
                    document.getElementById(`konten-${t}`).classList.remove('block');
                    
                    let btn = document.getElementById(`btn-${t}`);
                    btn.classList.remove('bg-blue-500', 'text-white', 'font-semibold');
                    btn.classList.add('bg-gray-200', 'text-gray-700');
                });

                // Tampilkan konten yang dipilih dan ubah gaya tombol menjadi aktif
                document.getElementById(`konten-${tab}`).classList.remove('hidden');
                document.getElementById(`konten-${tab}`).classList.add('block');
                
                let activeBtn = document.getElementById(`btn-${tab}`);
                activeBtn.classList.remove('bg-gray-200', 'text-gray-700');
                activeBtn.classList.add('bg-blue-500', 'text-white', 'font-semibold');
            });
        });
    </script>
</body>
</html>
